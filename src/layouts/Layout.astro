---
// Layout base de la calculadora.
// Solo provee la estructura HTML minima y carga los estilos globales.
// La logica vive en src/scripts/*.ts; aqui no hay JS.
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Calculadora CIDR & VLSM",
  description = "Calculadora client-side para subnetting fijo (CIDR) y máscara de longitud variable (VLSM).",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="cache-control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10 text-xs text-muted">
      Conmutación y enturamiento de redes de computadoras :)
    </footer>
  </body>

  <!--
    Unico punto de entrada de JS. Astro lo bundlea en un solo archivo
    (gracias a inlineDynamicImports + manualChunks en astro.config.mjs)
    para que no haya imports entre bundles. Asi el dist funciona tanto
    sirviendo en HTTP como abriendolo con file:// desde el .bat.
  -->
  <script>
    import { initTabs } from '../scripts/tabs';
    import { initCidr } from '../scripts/cidr-app';
    import { initVlsm } from '../scripts/vlsm-app';

    initTabs();
    initCidr();
    initVlsm();
  </script>
</html>
