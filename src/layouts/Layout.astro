---
// Layout base de la calculadora.
// Solo provee la estructura HTML minima y carga los estilos globales.
// La logica vive en src/scripts/*.ts; aqui no hay JS.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Calculadora CIDR & VLSM',
  description = 'Calculadora client-side para subnetting fijo (CIDR) y máscara de longitud variable (VLSM).',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10 text-xs text-muted">
      Calculadora CIDR &amp; VLSM · Ejecución 100% client-side · Hecha con Astro + TypeScript + Tailwind CSS.
    </footer>
  </body>
</html>
